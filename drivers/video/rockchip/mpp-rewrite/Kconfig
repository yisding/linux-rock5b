config ROCKCHIP_MPP_REWRITE
	tristate "Rockchip MPP service compatibility rewrite"
	depends on ARCH_ROCKCHIP
	depends on !ROCKCHIP_MPP_SERVICE
	select DMA_SHARED_BUFFER
	help
	  Minimal ABI-compatible /dev/mpp_service rewrite for RK3588 bring-up.
	  This driver preserves the userspace ioctl parser, query commands,
	  session switching, and dma-buf fd-to-IOVA import/release using public
	  APIs. It includes the RK3588 RKVENC2/VDPU381 register execution
	  paths used by current upstream MPP consumers while leaving unsupported
	  BSP-only commands as explicit errors.

config ROCKCHIP_MPP_REWRITE_KUNIT_TEST
	bool "KUnit tests for Rockchip MPP service compatibility rewrite" if !KUNIT_ALL_TESTS
	depends on ROCKCHIP_MPP_REWRITE=y && KUNIT
	default KUNIT_ALL_TESTS
	help
	  Unit tests for rewrite-local MPP ABI parser helpers, including
	  command range classification and register-span validation.
	  The in-source suite uses the service singleton as test-fixture
	  storage, so it is available only when the driver is built in and
	  can bind after the suite has completed.
